# CookMate AI Mobile App Environment Configuration
# Copy this file to .env and customize the values for your environment.

# The base URL of the Spring Boot backend API.
# Replace 192.168.1.10 with your computer's LAN IPv4 address (e.g. from ipconfig / ifconfig)
# DO NOT use localhost or 127.0.0.1 as it won't be reachable from physical mobile devices.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
